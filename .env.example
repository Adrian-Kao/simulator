# Backend environment template. Copy to `.env` and fill in locally.
# NEVER commit a real API key — `.env` is gitignored.

# Gemini is used ONLY to propose the next policy patch (signal green seconds,
# red-line metres, parking spaces). It never produces KPIs; every KPI comes from
# the Python simulation in `simulation/`.
#
# Leave this empty to run the sandbox without AI: /api/simulations keeps working
# and /api/reason + /api/optimize return status "ai_unavailable".
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
